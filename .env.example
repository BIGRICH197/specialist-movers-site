# Google Maps — address autocomplete on quote form (NZ addresses)
# Enable: Maps JavaScript API + Places API in Google Cloud Console
# Referrers: production domain, *.vercel.app, http://localhost:3055/*
# On Vercel: set in project env and REDEPLOY after changing NEXT_PUBLIC_*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only (Vercel → Settings → Environment Variables)
HUBSPOT_ACCESS_TOKEN=
ANTHROPIC_API_KEY=

# Optional canonical base URL
# NEXT_PUBLIC_SITE_URL=https://www.specialistmovers.co.nz

# Local quote testing: npm run dev auto-enables instant quotes without Places
# verification (routes assumed in-area Auckland). Set false to match production.
# NEXT_PUBLIC_QUOTE_DEV_BYPASS=false

# See docs/VERCEL_ENV.md for API troubleshooting
